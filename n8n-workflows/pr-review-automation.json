{
  "name": "PR Review Automation",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "github-pr-webhook",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "GitHub PR Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [250, 300],
      "webhookId": "pr-review-webhook"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "action-check",
              "leftValue": "={{ $json.body.action }}",
              "rightValue": "opened",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-pr-opened",
      "name": "If PR Opened",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [450, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:8000/run",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"input\": \"GitHub PR #{{ $json.body.pull_request.number }} 코드 리뷰를 수행해주세요.\\n\\n제목: {{ $json.body.pull_request.title }}\\n설명: {{ $json.body.pull_request.body }}\\n변경 파일 수: {{ $json.body.pull_request.changed_files }}\\n추가: +{{ $json.body.pull_request.additions }}\\n삭제: -{{ $json.body.pull_request.deletions }}\",\n  \"workflow\": \"coding\"\n}"
      },
      "id": "http-request-review",
      "name": "Run Code Review",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [650, 200]
    },
    {
      "parameters": {
        "owner": "={{ $json.body.repository.owner.login }}",
        "repository": "={{ $json.body.repository.name }}",
        "issueNumber": "={{ $json.body.pull_request.number }}",
        "body": "=:robot_face: **AI 코드 리뷰 결과**\\n\\n{{ $('Run Code Review').item.json.output }}\\n\\n---\\n_자동 생성된 리뷰입니다._"
      },
      "id": "github-comment",
      "name": "Post Review Comment",
      "type": "n8n-nodes-base.github",
      "typeVersion": 1,
      "position": [850, 200],
      "credentials": {
        "githubApi": {
          "id": "GITHUB_CREDENTIAL_ID",
          "name": "GitHub Account"
        }
      }
    },
    {
      "parameters": {
        "channel": "#pr-reviews",
        "text": "=:mag: *PR 리뷰 완료*\\n\\nPR: <{{ $json.body.pull_request.html_url }}|#{{ $json.body.pull_request.number }}>\\n제목: {{ $json.body.pull_request.title }}\\n작성자: {{ $json.body.pull_request.user.login }}",
        "otherOptions": {}
      },
      "id": "slack-notify",
      "name": "Notify Slack",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.1,
      "position": [1050, 200],
      "credentials": {
        "slackApi": {
          "id": "SLACK_CREDENTIAL_ID",
          "name": "Slack Account"
        }
      }
    }
  ],
  "connections": {
    "GitHub PR Webhook": {
      "main": [
        [
          {
            "node": "If PR Opened",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "If PR Opened": {
      "main": [
        [
          {
            "node": "Run Code Review",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run Code Review": {
      "main": [
        [
          {
            "node": "Post Review Comment",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Post Review Comment": {
      "main": [
        [
          {
            "node": "Notify Slack",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "tags": ["github", "pr-review", "automation"],
  "triggerCount": 1
}
