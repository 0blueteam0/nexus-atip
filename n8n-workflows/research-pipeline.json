{
  "name": "Research Pipeline",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "research-trigger",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Research Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [250, 300],
      "webhookId": "research-pipeline-webhook"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:8000/research",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"query\": \"{{ $json.body.query }}\",\n  \"research_type\": \"{{ $json.body.research_type || 'mixed' }}\"\n}"
      },
      "id": "http-research",
      "name": "Execute Research",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [450, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "success-check",
              "leftValue": "={{ $json.success }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-success",
      "name": "If Success",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [650, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:8000/run",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"input\": \"다음 연구 결과를 바탕으로 상세 보고서를 작성해주세요:\\n\\n요약: {{ $json.summary }}\\n\\n주요 발견: {{ $json.key_findings.join(', ') }}\\n\\n출처: {{ $json.sources.length }}개\",\n  \"workflow\": \"auto\"\n}"
      },
      "id": "http-report",
      "name": "Generate Report",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [850, 200]
    },
    {
      "parameters": {
        "channel": "#research-results",
        "text": "=:books: *연구 결과*\\n\\n*쿼리:* {{ $('Research Webhook').item.json.body.query }}\\n\\n*요약:*\\n{{ $('Execute Research').item.json.summary }}\\n\\n*신뢰도:* {{ Math.round($('Execute Research').item.json.confidence * 100) }}%",
        "otherOptions": {}
      },
      "id": "slack-success",
      "name": "Notify Success",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.1,
      "position": [1050, 200],
      "credentials": {
        "slackApi": {
          "id": "SLACK_CREDENTIAL_ID",
          "name": "Slack Account"
        }
      }
    },
    {
      "parameters": {
        "channel": "#research-results",
        "text": "=:warning: *연구 실패*\\n\\n*쿼리:* {{ $('Research Webhook').item.json.body.query }}\\n*오류:* {{ $json.error }}",
        "otherOptions": {}
      },
      "id": "slack-failure",
      "name": "Notify Failure",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.1,
      "position": [850, 400],
      "credentials": {
        "slackApi": {
          "id": "SLACK_CREDENTIAL_ID",
          "name": "Slack Account"
        }
      }
    }
  ],
  "connections": {
    "Research Webhook": {
      "main": [
        [
          {
            "node": "Execute Research",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Execute Research": {
      "main": [
        [
          {
            "node": "If Success",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "If Success": {
      "main": [
        [
          {
            "node": "Generate Report",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Notify Failure",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Generate Report": {
      "main": [
        [
          {
            "node": "Notify Success",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "tags": ["research", "pipeline", "automation"],
  "triggerCount": 1
}
