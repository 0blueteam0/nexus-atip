{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/ai-soc-agent/dataset_manifest.schema.json",
  "title": "Dataset Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "generated_by",
    "execution_policy",
    "sources"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "manifest_id": { "type": "string", "minLength": 1 },
    "generated_by": { "type": "string", "minLength": 1 },
    "execution_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["download_allowed", "production_connection_allowed", "notes"],
      "properties": {
        "download_allowed": { "type": "boolean", "const": false },
        "production_connection_allowed": { "type": "boolean", "const": false },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/source" }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "display_name",
        "source_type",
        "enabled",
        "download_allowed",
        "adapter",
        "ingestion_status",
        "license_notes",
        "coverage",
        "candidate_tasks",
        "case_templates",
        "limitations",
        "metadata_spec"
      ],
      "properties": {
        "source_id": { "type": "string", "minLength": 1 },
        "display_name": { "type": "string", "minLength": 1 },
        "source_type": { "type": "string", "enum": ["synthetic", "public"] },
        "enabled": { "type": "boolean" },
        "download_allowed": { "type": "boolean", "const": false },
        "adapter": { "type": "string", "minLength": 1 },
        "ingestion_status": {
          "type": "string",
          "enum": ["ready_local_fixture", "metadata_stub", "manual_review_required"]
        },
        "license_notes": { "type": "string" },
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["domains", "log_types", "mitre_tactics"],
          "properties": {
            "domains": { "type": "array", "items": { "type": "string" } },
            "log_types": { "type": "array", "items": { "type": "string" } },
            "mitre_tactics": { "type": "array", "items": { "type": "string" } }
          }
        },
        "candidate_tasks": { "type": "array", "items": { "type": "string" } },
        "case_templates": { "type": "array", "items": { "$ref": "#/$defs/caseTemplate" } },
        "limitations": { "type": "array", "items": { "type": "string" } },
        "metadata_spec": { "$ref": "#/$defs/metadataSpec" }
      }
    },
    "caseTemplate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["template_id", "scenario", "expected_evidence", "expected_guardrails"],
      "properties": {
        "template_id": { "type": "string", "minLength": 1 },
        "scenario": { "type": "string", "minLength": 1 },
        "expected_evidence": { "type": "array", "items": { "type": "string" } },
        "expected_guardrails": { "type": "array", "items": { "type": "string" } }
      }
    },
    "metadataSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spec_version",
        "source_url",
        "reference_urls",
        "access_review",
        "raw_data_profile",
        "normalization_contract",
        "evaluation_use"
      ],
      "properties": {
        "spec_version": { "type": "string", "const": "2.0" },
        "source_url": { "type": "string", "minLength": 1 },
        "reference_urls": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "access_review": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "download_requires_approval",
            "license_review_required",
            "redistribution_review_required",
            "pii_or_sensitive_risk"
          ],
          "properties": {
            "download_requires_approval": { "type": "boolean" },
            "license_review_required": { "type": "boolean" },
            "redistribution_review_required": { "type": "boolean" },
            "pii_or_sensitive_risk": { "type": "string", "enum": ["low", "medium", "high"] }
          }
        },
        "raw_data_profile": {
          "type": "object",
          "additionalProperties": false,
          "required": ["expected_formats", "expected_time_fields", "expected_entity_fields", "volume_notes"],
          "properties": {
            "expected_formats": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "expected_time_fields": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "expected_entity_fields": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "volume_notes": { "type": "string" }
          }
        },
        "normalization_contract": {
          "type": "object",
          "additionalProperties": false,
          "required": ["target_schemas", "required_mappings", "unsupported_fields_handling"],
          "properties": {
            "target_schemas": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "required_mappings": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "unsupported_fields_handling": { "type": "string" }
          }
        },
        "evaluation_use": {
          "type": "object",
          "additionalProperties": false,
          "required": ["primary_metrics", "excluded_uses"],
          "properties": {
            "primary_metrics": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "excluded_uses": { "type": "array", "minItems": 1, "items": { "type": "string" } }
          }
        }
      }
    }
  }
}
