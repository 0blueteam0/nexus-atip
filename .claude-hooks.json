{
  "hooks": {
    "observer-session-start": {
      "enabled": true,
      "command": "curl -s -X POST http://localhost:3847/session/start -H \"Content-Type: application/json\" -d \"{\\\"sessionId\\\": \\\"$SESSION_ID\\\"}\" 2>/dev/null || true",
      "triggers": ["session-start"],
      "priority": "high",
      "description": "Notify Swarm Commander Observer of session start"
    },
    "observer-session-end": {
      "enabled": true,
      "command": "curl -s -X POST http://localhost:3847/session/end -H \"Content-Type: application/json\" -d \"{\\\"sessionId\\\": \\\"$SESSION_ID\\\"}\" 2>/dev/null || true",
      "triggers": ["session-end"],
      "priority": "high",
      "description": "Notify Swarm Commander Observer of session end"
    },
    "observer-tool-track": {
      "enabled": true,
      "command": "curl -s -X POST http://localhost:3847/tool -H \"Content-Type: application/json\" -d \"{\\\"tool_name\\\": \\\"$TOOL_NAME\\\", \\\"success\\\": $TOOL_SUCCESS, \\\"duration_ms\\\": $TOOL_DURATION}\" 2>/dev/null || true",
      "triggers": ["PostToolResult"],
      "priority": "low",
      "description": "Track tool usage in Swarm Commander for Bayesian learning"
    }
  }
}
